# Copy to .env and fill in. Never commit .env - it holds real credentials.

# Required in production. Must be >= 32 characters.
# The app refuses to start when ENVIRONMENT=production and this is unset or
# still the development placeholder, so a missing secret is a boot failure
# rather than a silent insecure deployment.
SECRET_KEY=

ENVIRONMENT=development

# Local development services. Change these per environment.
DATABASE_URL=postgresql+psycopg://store:store@localhost:5432/store
REDIS_URL=redis://localhost:6379/0

# Comma-separated. Empty disables cross-origin access entirely, which is the
# correct default. Do not use "*".
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
